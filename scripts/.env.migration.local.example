# Copy this file to `.env.migration.local` and fill in real values.
# `.env.migration.local` is git-ignored (matches *.local pattern).
#
# WHERE TO GET THESE:
#   1. Supabase Dashboard → Project Settings → API
#   2. Copy "Project URL" → SUPABASE_URL
#   3. Copy "service_role" secret (NOT anon key!) → SUPABASE_SERVICE_ROLE_KEY
#
# WARNING:
#   - service_role key BYPASSES ALL RLS. Never share, never commit.
#   - Chỉ dùng service_role trong script Node local, KHÔNG bao giờ trong browser.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...paste-service-role-jwt-here...
